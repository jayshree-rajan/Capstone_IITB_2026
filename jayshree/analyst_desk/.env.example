# Copy this file to .env and fill in your values
# NEVER commit .env — it is in .gitignore

# OpenRouter API key — get one at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# LLM for C0 pipeline (prescribed in capstone PDF)
C0_MODEL=openai/gpt-4.1-mini

# Optional: secret that signs analyst approvals (rule 3). If unset, a random
# key is created in data/approval/approval.key (local) or the shared approval volume (Docker).
# APPROVAL_SECRET=
